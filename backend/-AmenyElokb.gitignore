# ----------------------------------------
# Laravel defaults
# ----------------------------------------

/vendor/
.env
.env.*
.phpunit.result.cache
/storage/*.key
/storage/app/public
/storage/framework/cache/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*.log
/public/storage
/bootstrap/cache/*
!storage/.gitignore
!bootstrap/cache/.gitignore

# ----------------------------------------
# Node.js & Frontend
# ----------------------------------------

node_modules/
package-lock.json
yarn.lock
npm-debug.log
yarn-error.log
dist/

# ----------------------------------------
# IDEs & OS-specific
# ----------------------------------------

.idea/
.vscode/
*.swp
.DS_Store

# ----------------------------------------
# Deployment / SSL / Nginx
# ----------------------------------------

/public/.well-known/
/letsencrypt/
/nginx/*.pem
/nginx/backend.conf

# ----------------------------------------
# API Docs (Swagger/Scribe/etc.)
# ----------------------------------------

storage/api-docs/api-docs.json

# ----------------------------------------
# Misc (Dynamic files, compiled output)
# ----------------------------------------

components.d.ts
/public/hot
/public/build
/.fleet
auth.json
